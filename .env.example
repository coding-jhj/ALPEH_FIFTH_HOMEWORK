# 서버 전용 값입니다. 이 파일에는 실제 값을 절대 적지 마세요.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# 원천: mcstatus | mcsrvstat  (둘 다 인증 키가 필요 없는 공개 API)
NEXT_PUBLIC_SIGNAL_PROVIDER=mcstatus
MC_SERVER_HOST=mc.hypixel.net
NEXT_PUBLIC_SIGNAL_ID=mc-server-players
NEXT_PUBLIC_SIGNAL_TITLE=mc.hypixel.net 현재 접속자
LIVE_DEADLINE_MS=4000

# 기록 잠금. 2일차 영수증을 봉인한 뒤 true 로 바꾸면
# 조회는 계속 되지만 일별 저장값을 더 바꾸지 않습니다 (T04-C23 보호).
RECORD_LOCKED=false
